# USDA FoodData Central API Key
# Obtenha sua chave em: https://fdc.nal.usda.gov/api-key-signup.html
VITE_USDA_API_KEY=DEMO_KEY

# Google Analytics (opcional)
# VITE_GA_ID=G-XXXXXXXXXX

# Stripe (opcional - configurar diretamente no código)
# VITE_STRIPE_PUBLIC_KEY=pk_live_XXXXXXXXXX

# Stripe, checkout do Team (api/team-checkout.js). Configure no Vercel, nunca no codigo.
# Crie uma chave RESTRITA em dashboard.stripe.com/apikeys com so a permissao "Checkout Sessions: Write".
# STRIPE_SECRET_KEY=rk_live_XXXXXXXXXX
